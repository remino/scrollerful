{
	"compilerOptions": {
		"allowJs": false,
		"checkJs": false,
		"lib": ["DOM", "ES2020"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": false,
		"target": "ES2020",
		"types": []
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["dist", "build", "deploy", "node_modules"]
}
