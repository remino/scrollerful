---
import BaseLayout from '../../components/BaseLayout.astro'
import Logo from '../../components/Logo.astro'
import Usage from '../../content/scrollerful-usage.md'
import { site } from '../../data/site.ts'
import '../../assets/css/site.css'

const pageUrl = site.url
---

<BaseLayout
	title={site.title}
	description={site.description}
	initializeScrollerful={false}
	pageUrl={pageUrl}
	bodyClass="demo--vertical demo--cover">
	<header class="sclf contain-always">
		<div class="sclf__float content">
			<h1 class="sclf__sprite">
				<Logo />
			</h1>
			<h2 class="sclf__sprite--contain">
				Small JS &amp; CSS library for scroll animations
			</h2>
			<template class="js-template">
				<p class="sclf__sprite--contain">Scroll to start</p>
				<div class="scroll-down sclf__sprite">
					<div class="scroll-down__wrapper">
						<div class="scroll-down__arrow"></div>
						<div class="scroll-down__arrow"></div>
						<div class="scroll-down__arrow"></div>
						<div class="scroll-down__arrow"></div>
					</div>
				</div>
			</template>
		</div>
	</header>

	<noscript>
		<section class="prose warning">
			<p>⚠️ The scroll animations on this page require JavaScript.</p>
		</section>
	</noscript>

	<template class="js-template">
		<section id="motto" class="sclf">
			<div class="sclf__float content">
				<h2 class="motto">
					<span class="motto__text motto__text--scroll sclf__sprite--contain"
						>Scroll</span
					>
					<span class="motto__text motto__text--with sclf__sprite--contain"
						>with</span
					>
					<span class="motto__text motto__text--style sclf__sprite--contain">
						<strong class="sclf__sprite">style!</strong>
					</span>
				</h2>
			</div>
		</section>
	</template>

	<section id="usage" class="prose">
		<article class="prose__article content sclf__sprite--contain">
			<Usage />
		</article>
	</section>

	<template class="demo-template js-template">
		<section id="demo" class="section--scroll-scroll sclf">
			<div class="sclf__float content">
				<div class="bg sclf__sprite">
					<p class="item--scroll-scroll sclf__sprite">Scroll!</p>
				</div>
			</div>
		</section>

		<section class="section--percentage sclf">
			<div class="sclf__float content">
				<div class="bg sclf__sprite"></div>
				<h2 class="item--percentage sclf__sprite"><output></output>%</h2>
			</div>
		</section>

		<section class="section--piechart sclf">
			<div class="sclf__float content">
				<div class="bg sclf__sprite"></div>
				<div class="item--piechart sclf__sprite"></div>
			</div>
		</section>

		<section class="section--video sclf">
			<div class="sclf__float content">
				<div class="bg sclf__sprite"></div>
				<video autoplay controls muted playsinline>
					<source src="/scrollerful/demo.mp4" type="video/mp4" />
				</video>
			</div>
		</section>

		<details class="controls">
			<summary>Demo Controls</summary>
			<form aria-label="Demo controls">
				<fieldset>
					<legend>Direction</legend>
					<label>
						<input type="radio" name="direction" value="vertical" checked />
						<span>Vertical</span>
					</label>
					<label>
						<input type="radio" name="direction" value="horizontal" />
						<span>Horizontal</span>
					</label>
				</fieldset>

				<fieldset>
					<legend>Container Size</legend>
					<label>
						<input type="radio" name="size" value="300" checked />
						<span>300%</span>
					</label>
					<label>
						<input type="radio" name="size" value="100" />
						<span>100%</span>
					</label>
					<label>
						<input type="radio" name="size" value="50" />
						<span>50%</span>
					</label>
				</fieldset>

				<fieldset>
					<legend>Sprite Scope</legend>
					<label>
						<input type="radio" name="scope" value="cover" checked />
						<span>Cover</span>
					</label>
					<label>
						<input type="radio" name="scope" value="contain" />
						<span>Contain</span>
					</label>
				</fieldset>
			</form>
		</details>
	</template>

	<footer class="sclf contain-always">
		<div class="sclf__float content">
			<nav class="sclf__sprite--contain" aria-label="Scrollerful resources">
				<dl>
					<dt>
						<a href="https://github.com/remino/scrollerful">Code &amp; Docs</a>
					</dt>
					<dd>on GitHub</dd>
				</dl>
			</nav>
			<nav class="sclf__sprite--contain" aria-label="Page navigation">
				<a href="#">Scroll back to start</a>
			</nav>
		</div>
	</footer>

	<div class="bg">
		<div class="bg__color-1 sclf__sprite--contain"></div>
		<div class="bg__color-2 sclf__sprite--contain"></div>
		<div class="bg__center"></div>
		<div class="bg__cover sclf__sprite--contain"></div>
	</div>
	<script src="../../assets/js/site.ts"></script>
</BaseLayout>
