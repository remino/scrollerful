---
import BaseLayout from '../../../components/BaseLayout.astro'
import Logo from '../../../components/Logo.astro'
import { site } from '../../../data/site.ts'
import '../../../assets/css/demo.css'
---
<BaseLayout
	title={site.title}
	description={site.description}
	pageUrl={`${site.url}demo/`}
	bodyClass="demo--vertical demo--large demo--cover">
	<form class="controls">
		<fieldset>
			<legend>Direction</legend>
			<label>
				<input type="radio" name="direction" value="vertical" checked />
				<span>Vertical</span>
			</label>
			<label>
				<input type="radio" name="direction" value="horizontal" />
				<span>Horizontal</span>
			</label>
		</fieldset>

		<fieldset>
			<legend>Container Size</legend>
			<label>
				<input type="radio" name="size" value="large" checked />
				<span>Large</span>
			</label>
			<label>
				<input type="radio" name="size" value="medium" />
				<span>Medium</span>
			</label>
			<label>
				<input type="radio" name="size" value="small" />
				<span>Small</span>
			</label>
		</fieldset>

		<fieldset>
			<legend>Sprite Scope</legend>
			<label>
				<input type="radio" name="scope" value="cover" checked />
				<span>Cover</span>
			</label>
			<label>
				<input type="radio" name="scope" value="contain" />
				<span>Contain</span>
			</label>
		</fieldset>

		<nav>
			<a href="/scrollerful/">
				<span>Back to</span>
				<Logo />
			</a>
		</nav>
	</form>

	<section class="section--scroll-scroll sclf">
		<div class="sclf__float">
			<div class="bg sclf__sprite">
				<p class="item--scroll-scroll sclf__sprite">Scroll!</p>
			</div>
		</div>
	</section>

	<section class="section--percentage sclf">
		<div class="sclf__float">
			<div class="bg sclf__sprite"></div>
			<h1 class="item--percentage sclf__sprite">
				<output></output>%
			</h1>
		</div>
	</section>

	<section class="section--piechart sclf">
		<div class="sclf__float">
			<div class="bg sclf__sprite"></div>
			<div class="item--piechart sclf__sprite"></div>
		</div>
	</section>

	<section class="section--video sclf">
		<div class="sclf__float">
			<div class="bg sclf__sprite"></div>
			<video autoplay controls muted playsinline>
				<source src="/scrollerful/demo.mp4" type="video/mp4" />
			</video>
		</div>
	</section>
	<script slot="scripts" defer src="/scrollerful/demo.js"></script>
</BaseLayout>
