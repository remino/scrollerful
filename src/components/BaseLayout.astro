---
import SiteNavFooter from '@remino/astro-site-nav/SiteNavFooter.astro'
import SiteNavHeader from '@remino/astro-site-nav/SiteNavHeader.astro'
import SiteNavHtmlHead from '@remino/astro-site-nav/SiteNavHtmlHead.astro'
import HeaderNav from './HeaderNav.astro'
import { site } from '../data/site'
import '../assets/css/style.css'

const {
	bodyClass = '',
	description = site.description,
	pageUrl = site.url,
	title = site.title,
} = Astro.props

const navItems = [
	{ label: 'Home', href: '/scrollerful/' },
	{ label: 'Demo', href: '/scrollerful/#demo' },
	{
		label: 'GitHub',
		href: 'https://github.com/remino/scrollerful',
		external: true,
	},
	{
		label: 'npm',
		href: 'https://www.npmjs.com/package/scrollerful',
		external: true,
	},
]
---
<!doctype html>
<html lang="en" class="no-js rmn-nav-ribbon-bg-blur">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="viewport-fit=cover, width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={site.shareImage} />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={site.shareImage} />
		<meta name="twitter:site" content={site.twitterHandle} />
		<meta name="twitter:creator" content={site.twitterHandle} />
		<meta name="twitter:url" content={pageUrl} />
		<SiteNavHtmlHead />
		<slot name="head" />
		<script>
			document.documentElement.classList.add('js')
			document.documentElement.classList.remove('no-js')
		</script>
	</head>
	<body class={bodyClass}>
		<SiteNavHeader />
		<header class="site-header">
			<a href="/scrollerful/">Scrollerful</a>
			<HeaderNav items={navItems} />
		</header>
		<slot />
		<SiteNavFooter>
			<a href="/scrollerful/">Scrollerful</a>
		</SiteNavFooter>
		<script is:inline src="/scrollerful/script.js"></script>
		<slot name="scripts" />
	</body>
</html>
